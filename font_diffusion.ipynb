    "# @title Run ultimately massive generations\n",
    "if is_colab:\n",
    "    !uv pip install --upgrade huggingface_hub\n",
    "else:\n",
    "    !uv pip install --upgrade \"huggingface-hub==0.25.2\" \"protobuf<5.0.0\" \"numpy<2.0.0\"\n",
    "%cd {OUTPUT_PATH}\n",
    "# No need to pass num_processes because accelerate auto detect num gpus on machine\n",
    "!accelerate launch FontDiffusion/run_inference.py \\\n",
    "    --mode sample_distributed \\\n",
    "    --characters \"NomTuTao/Ds_10k_ChuNom_TuTao.txt\" \\\n",
    "    --style_images \"FontDiffusion/style_images/cleaned_handwritten_enhanced\" \\\n",
    "    --ckpt_dir \"outputs/FontArchitect/FST-P2-20260218/checkpoint_step_1000\" \\\n",
    "    --fst_ckpt_path \"outputs/FontArchitect/FST-P2-20260218/checkpoint_step_1000\" \\\n",
    "    --ttf_path \"FontDiffusion/fonts/NomNaTong-Regular.otf\" \\\n",
    "    --output_dir \"FST-FFT-total\" \\\n",
    "    --num_inference_steps 20 \\\n",
    "    --guidance_scale 7.5 \\\n",
    "    --start_line 100 \\\n",
    "    --end_line 120 \\\n",
    "    --batch_size 64 \\\n",
    "    --save_interval 1 \\\n",
    "    --channels_last \\\n",
    "    --seed 42 \\\n",
    "    --use_fst"
   ]
