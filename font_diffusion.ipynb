results\n# output_base = \"evaluation_inference_steps\"\n\n# for i, folder1 in enumerate(folders):\n#     for j, folder2 in enumerate(folders):\n#         if i >= j:\n#             continue  # Avoid duplicate/self-comparison\n#         out_dir = Path(output_base) / f\"{Path(folder1).stem}_vs_{Path(folder2).stem}\"\n#         cmd = [\n#             \"python\", \"FontDiffusion/evaluate.py\",\n#             \"--folder1\", folder1,\n#             \"--folder2\", folder2,\n#             \"--folder1_name\", Path(folder1).stem,\n#             \"--folder2_name\", Path(folder2).stem,\n#             \"--output_dir\", str(out_dir)\n#         ]\n#         print(f\"Running: {' '.join(cmd)}\")\n#         subprocess.run(cmd, check=True)","metadata":{"id":"ff2cbb42","papermill":{"duration":0.395289,"end_time":"2026-01-31T22:17:16.455280","exception":false,"start_time":"2026-01-31T22:17:16.059991","status":"completed"},"scrolled":true,"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"id":"d9562c80","cell_type":"code","source":"import os\nimport zipfile\nfrom pathlib import Path\n\n\ndef find_result_folders(base_path: Path, pattern_name: str) -> list[Path]:\n    return [p for p in base_path.glob(pattern_name) if p.is_dir()]\n\n\ndef zip_folder(folder_path: Path, output_base_path: Path) -> bool:\n    folder_name = folder_path.name\n    zip_path = output_base_path / f\"{folder_name}.zip\"\n    try:\n        print(f\"   -> Zipping folder: {folder_name}...\")\n        with zipfile.ZipFile(\n            zip_path, mode=\"w\", compression=zipfile.ZIP_DEFLATED\n        ) as zipf:\n            for file_path in folder_path.rglob(\"*\"):\n                if file_path.is_file():\n                    arcname = file_path.relative_to(folder_path.parent)\n                    zipf.write(file_path, arcname)\n        print(f\"  Created ZIP: {zip_path.name}\")\n        return True\n    except Exception as exc:\n        print(f\"   Failed to zip {folder_name}: {exc}\")\n        return False\n\n\ndef zip_stats_results_folders(output_base_path: str, pattern_name: str) -> None:\n    base = Path(output_base_path)\n    base.mkdir(parents=True, exist_ok=True)\n    result_folders = find_result_folders(base, pattern_name)\n    if not result_folders:\n        print(f\"⚠️ No folders matching {pattern_name} found in '{output_base_path}'.\")\n        return\n    print(f\"Found {len(result_folders)} result folder(s) to zip.\")\n    successful = sum(1 for folder in result_folders if zip_folder(folder, base))\n    print(\n        f\"\\nDONE! Successfully zipped {successful} out of {len(result_folders)} folder(s).\"\n    )\n\n\nif __name__ == \"__main__\":\n    try:\n        print(\"📦 Output Path:\", OUTPUT_PATH)\n        pattern_names = [\"*generations*\", \"evaluation*\", \"total\", \"val\", \"train\"]\n        output_root = os.getenv(\"OUTPUT_PATH\") or globals().get(\"OUTPUT_PATH\")\n        if not output_root:\n            raise ValueError(\"OUTPUT_PATH not defined\")\n        for pattern_name in pattern_names:\n            zip_stats_results_folders(\n                output_base_path=OUTPUT_PATH, pattern_name=pattern_name\n            )\n    except Exception as e:\n        print(f\"❌ An error occurred: {e}\")","metadata":{"id":"d9562c80","papermill":{"duration":4.35054,"end_time":"2026-01-31T22:17:21.200949","exception":false,"start_time":"2026-01-31T22:17:16.850409","status":"completed"},"scrolled":true,"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"id":"5f7f438e","cell_type":"code","source":"if is_colab:\n    from google.colab import files\n    files.download(\"/content/evaluation_inference_steps.zip\")\nfrom IPython.display import FileLink\nFileLink(\"total.zip\")","metadata":{"id":"5f7f438e","papermill":{"duration":0.413588,"end_time":"2026-01-31T22:17:22.009575","exception":false,"start_time":"2026-01-31T22:17:21.595987","status":"completed"},"scrolled":true,"tags":[],"trusted":true},"outputs":[],"execution_count":null}]}
