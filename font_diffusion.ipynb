    "from ast import main\n",
    "\n",
    "# @title Run ultimately massive generations\n",
    "if is_colab:\n",
    "    !uv pip install --upgrade \"huggingface-hub>=0.34.0,<1.0\"\n",
    "else:\n",
    "    !uv pip install --upgrade \"huggingface-hub==0.25.2\" \"protobuf<5.0.0\" \"numpy<2.0.0\"\n",
    "%cd {OUTPUT_PATH}\n",
    "# No need to pass num_processes because accelerate auto detect num gpus on machine\n",
    "!accelerate launch FontDiffusion/run_inference.py \\\n",
    "    --mode sample_distributed \\\n",
    "    --characters \"NomTuTao/Ds_10k_ChuNom_TuTao.txt\" \\\n",
    "    --style_images \"FontDiffusion/style_images/thanh*.png\" \\\n",
    "    --ckpt_dir \"outputs/FontDiffuser/phase2/final/\" \\\n",
    "    --ttf_path \"FontDiffusion/fonts/NomNaTong-Regular.otf\" \\\n",
    "    --output_dir \"10k_phase1_3k_phase2_predictions\" \\\n",
    "    --num_inference_steps 20 \\\n",
    "    --guidance_scale 7.5 \\\n",
    "    --start_line 7001 \\\n",
    "    --end_line 7005 \\\n",
    "    --batch_size 16 \\\n",
    "    --save_interval 1 \\\n",
    "    --channels_last \\\n",
    "    --seed 42 \\\n",
    "    --compile\n",
    "\n",
    "!uv pip install --upgrade pyarrow datasets\n",
    "!python FontDiffusion/tools/generate_metadata.py \\\n",
    "    --data_root \"my_dataset/handwritten_original\" \\\n",
    "    --output \"my_dataset/handwritten_original/results_checkpoint.json\""
   ]
