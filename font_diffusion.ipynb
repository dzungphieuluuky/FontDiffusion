  pattern_names = [\"*res*\", \"FST*\", \"evaluation*\", \"DRO*\"]\n        output_root = os.getenv(\"OUTPUT_PATH\") or globals().get(\"OUTPUT_PATH\")\n        if not output_root:\n            raise ValueError(\"OUTPUT_PATH not defined\")\n        for pattern_name in pattern_names:\n            zip_stats_results_folders(\n                output_base_path=OUTPUT_PATH, pattern_name=pattern_name\n            )\n    except Exception as e:\n        print(f\"❌ An error occurred: {e}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"if is_colab:\n    from google.colab import files\n    files.download(\"/content/evaluation_inference_steps.zip\")\nfrom IPython.display import FileLink\nFileLink(\"FFT-best_results.zip\")","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}
