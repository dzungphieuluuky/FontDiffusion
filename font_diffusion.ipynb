e},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# @title Training phase 1\nif is_colab:\n    !uv pip install --upgrade huggingface_hub\nelse:\n    !uv pip install --upgrade \"huggingface-hub==0.25.2\" \"protobuf<5.0.0\" \"numpy<2.0.0\"\n\nimport wandb\nfrom IPython import get_ipython\n\nipython = get_ipython()\n\n# --- Loop Configuration ---\nMAX_TRAIN_STEPS = 15000\nSTEP_CHUNK = 500\nSTART_STEP = 4000  # Based on your initial phase_1_ckpt_dir\n\nOUTPUT_DIR = \"outputs/FontArchitect/FFT-identity-paper-experiment\"\nINITIAL_CKPT = \"ckpt/FFT-identity-paper-experiment/checkpoint_step_4000\"\n\n# Loop from 1000 to 15000 in increments of 500\nfor target_steps in range(START_STEP + STEP_CHUNK, MAX_TRAIN_STEPS + 1, STEP_CHUNK):\n    prev_steps = target_steps - STEP_CHUNK\n    \n    # Dynamically select the checkpoint to resume from\n    if prev_steps == START_STEP:\n        resume_ckpt = INITIAL_CKPT\n    else:\n        resume_ckpt = f\"{OUTPUT_DIR}/checkpoint_step_{prev_steps}\"\n        \n    print(f\"\\n{'='*60}\")\n    print(f\"🚀 RUNNING TRAINING: Step {prev_steps} to {target_steps}\")\n    print(f\"📂 Resuming from: {resume_ckpt}\")\n    print(f\"{'='*60}\\n\")\n    \n    # 1. Training Command\n    train_cmd = f\"\"\"accelerate launch --num_processes=1 FontDiffusion/train_fst.py \\\n        --seed=123 \\\n        --experience_name=\"FontDiffuserFFT_training_phase_1\" \\\n        --data_root=\".\" \\\n        --output_dir=\"{OUTPUT_DIR}\" \\\n        --phase_1 \\\n        --use_wandb \\\n        --report_to=\"wandb\" \\\n        --phase_1_ckpt_dir=\"{resume_ckpt}\" \\\n        --resume_from_checkpoint=\"{resume_ckpt}\" \\\n        --freeze_modules \"unet,style_encoder,content_encoder\" \\\n        --style_source_same_prob=0.5 \\\n        --num_consistency_pairs=3 \\\n        --num_identity_pairs=3 \\\n        --resolution=96 \\\n        --style_image_size=96 \\\n        --content_image_size=96 \\\n        --content_encoder_downsample_size=3 \\\n        --channel_attn \\\n        --content_start_channel=64 \\\n        --style_start_channel=64 \\\n        --train_batch_size=4 \\\n        --gradient_accumulation_steps=2 \\\n        --perceptual_coefficient=0.03 \\\n        --offset_coefficient=0.3 \\\n        --max_train_steps={target_steps} \\\n        --ckpt_interval=500 \\\n        --log_interval=50 \\\n        --learning_rate=1e-4 \\\n        --lr_scheduler=\"cosine\" \\\n        --lr_warmup_steps=2000 \\\n        --drop_prob=0.1 \\\n        --compile \\\n        --mixed_precision=\"no\" \\\n        --use_fst \\\n        --use_frequency_decomp\"\"\"\n        \n    try:\n        ipython.system(train_cmd)\n    except Exception as e:\n        print(f\"❌ Get something wrong during training. Stopping loop! Error: {e}\")\n        break\n\n    print(f\"\\n{'='*60}\")\n    print(f\"☁️ UPLOADING TO HUGGINGFACE: Checkpoint {target_steps}\")\n    print(f\"{'='*60}\\n\")\n    \n    upload_cmd = f\"\"\"python FontDiffusion/src/tools/upload_models_hybrid.py \\\n        --weights_dir \"{OUTPUT_PATH}/outputs/FontArchitect/\" \\\n        --repo_id \"dzungpham/font-architect\" \\\n        --token \"{HF_TOKEN}\" \\\n        --recursive \\\n        --parallel 8 \\\n        --verbose \\\n        --commit_message \"FST training with consistency and identity loss - Step {target_steps}\" \"\"\"\n        \n    try:\n        ipython.system(upload_cmd)\n    except Exception as e:\n        print(f\"❌ Get something wrong during upload. Stopping loop! Error: {e}\")\n        break\n        \nprint(\"\\n🎉 Training and Upload pipeline completed!\")","metadata":{"trusted":true,"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!ls -lr ckpt/*\n!ls -lr ckpt/*/*\n!ls -lr outputs/FontArchitect/*/*","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# @title Training phase 2 with SCR\nif is_colab:\n    !uv pip install --upgrade huggingface_hub\nelse:\n    !uv pip instal