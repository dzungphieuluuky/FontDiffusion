import pytest
import torch

class TestFSTModuleIntegration:
    def test_fst_forward_backward_flow(self):
        input_tensor = torch.randn(2, 128, 640)
        output = model(input_tensor)
        assert output.shape == (2, 128, expected_output_shape)

    @pytest.mark.parametrize("input_size", [(64, 64), (128, 128), (256, 128)])
    def test_fst_variable_configs(self, input_size):
        input_tensor = torch.randn(2, input_size[0], 320)
        output = model(input_tensor)
        assert output.shape == (2, input_size[1], expected_output_shape)

class TestFSTWithMSSEPipeline:
    def test_msse_to_fst_pipeline(self):
        input_a = torch.randn(2, 128)
        input_b = torch.randn(2, 64)
        with pytest.raises(RuntimeError):
            output = model(input_a, input_b)

