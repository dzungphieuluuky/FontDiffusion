    "# @title Training phase 2 with SCR\n",
    "if is_colab:\n",
    "    !uv pip install --upgrade huggingface_hub\n",
    "else:\n",
    "    !uv pip install --upgrade \"huggingface-hub==0.25.2\" \"protobuf<5.0.0\" \"numpy<2.0.0\"\n",
    "\n",
    "!wandb login\n",
    "MAX_TRAIN_STEPS = 1500\n",
    "!accelerate launch FontDiffusion/train_fst.py \\\n",
    "    --seed=123 \\\n",
    "    --experience_name=\"FontDiffuserFST_training_phase_2\" \\\n",
    "    --data_root=\".\" \\\n",
    "    --output_dir=\"outputs/FontArchitect/FST-P2-20260218\" \\\n",
    "    --report_to=\"wandb\" \\\n",
    "    --phase_2 \\\n",
    "    --phase_1_ckpt_dir=\"ckpt/FST-P2-20260218/checkpoint_step_2250/\" \\\n",
    "    --scr_ckpt_path=\"ckpt/FST-P2-20260218/checkpoint_step_2250/scr.safetensors\" \\\n",
    "    \\\n",
    "    --use_fst \\\n",
    "    --style_source_same_prob=0.5 \\\n",
    "    --num_consistency_pairs=3 \\\n",
    "    --num_identity_pairs=0 \\\n",
    "    \\\n",
    "    --use_frequency_decomp \\\n",
    "    \\\n",
    "    --sc_coefficient=0.03 \\\n",
    "    --num_neg=32 \\\n",
    "    --resolution=96 \\\n",
    "    --style_image_size=96 \\\n",
    "    --content_image_size=96 \\\n",
    "    --content_encoder_downsample_size=3 \\\n",
    "    --channel_attn \\\n",
    "    --content_start_channel=64 \\\n",
    "    --style_start_channel=64 \\\n",
    "    \\\n",
    "    --train_batch_size=4 \\\n",
    "    --gradient_accumulation_steps=2 \\\n",
    "    --perceptual_coefficient=0.03 \\\n",
    "    --offset_coefficient=0.3 \\\n",
    "    --max_train_steps={MAX_TRAIN_STEPS} \\\n",
    "    --ckpt_interval={MAX_TRAIN_STEPS // 3} \\\n",
    "    --log_interval=50 \\\n",
    "    \\\n",
    "    --learning_rate=5e-5 \\\n",
    "    --lr_scheduler=\"cosine\" \\\n",
    "    --lr_warmup_steps=200 \\\n",
    "    --drop_prob=0.1 \\\n",
    "    --mixed_precision=\"no\" \\\n",
    "    --compile"
   ]
